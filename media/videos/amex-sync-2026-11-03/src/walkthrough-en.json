    {
      "start": 0.8,
      "end": 5.64,
      "text": "Your cards come with perks. Keeping track shouldn't be another job."
    },
    {
      "start": 5.64,
      "end": 11.01,
      "text": "Meet Perks Reminder. Add your cards and bring your benefits into one place."
    },
    {
      "start": 11.01,
      "end": 14.61,
      "text": "See what's available, what's already used, and what's coming up."
    },
    {
      "start": 14.61,
